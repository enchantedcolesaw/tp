@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor STORAGE_COLOR
skinparam classBackgroundColor STORAGE_COLOR

package Storage as StoragePackage {

Class "<<interface>>\nStorage" as Storage
Class StorageManager

package "UserPrefs Storage" #F4F6F6{
Class JsonUserPrefsStorage
}

package "TAssist Storage" #F4F6F6{
Class JsonTAssistStorage
Class JsonSerializableTAssist
Class JsonAdaptedGroup
Class JsonAdaptedStudent
Class JsonAdaptedAssignmentRecord
}

package "Export" #F4F6F6{
Class GroupRecordsCsvExporter
}

}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Storage

package Model as ModelPackage <<Rectangle>> {
Class HiddenModel #FFFFFF
}

StorageManager .up.|> Storage
StorageManager -down-> "1" JsonUserPrefsStorage
StorageManager -down-> "1" JsonTAssistStorage

JsonTAssistStorage ..> JsonSerializableTAssist
JsonSerializableTAssist --> "*" JsonAdaptedGroup
JsonAdaptedGroup --> "*" JsonAdaptedStudent
JsonAdaptedGroup --> "*" JsonAdaptedAssignmentRecord

JsonSerializableTAssist ..> ModelPackage
GroupRecordsCsvExporter ..> ModelPackage

@enduml
