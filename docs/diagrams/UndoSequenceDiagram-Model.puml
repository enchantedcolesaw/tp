@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Model MODEL_COLOR_T1
participant ":ModelManager" as ModelManager MODEL_COLOR
participant ":TAssistHistory" as TAssistHistory MODEL_COLOR
participant ":Version" as Version MODEL_COLOR
participant ":TAssist" as TAssist MODEL_COLOR
end box

[-> ModelManager : undoTAssist()
activate ModelManager

ModelManager -> TAssistHistory : undo(current)
activate TAssistHistory

TAssistHistory -> TAssistHistory : pop undo version v
activate TAssistHistory
deactivate TAssistHistory
create Version
TAssistHistory -> Version : Version(current, description)
activate Version
Version --> TAssistHistory
deactivate Version
note right of TAssistHistory : The new version is\npushed for redo.

TAssistHistory --> ModelManager : v
deactivate TAssistHistory

ModelManager -> TAssist : resetData(v.data())
activate TAssist

TAssist --> ModelManager
deactivate TAssist

[<-- ModelManager : v.description()
deactivate ModelManager
@enduml
